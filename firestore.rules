rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /points/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /favorites/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /notificationSettings/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /fcmTokens/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /paymentMethods/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /deliveryAddresses/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /orders/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /pickup_orders/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /subscriptions/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /gifts/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /wholesale_quotes/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /reviews/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /product_stats/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /qrTokens/{code} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.used != true
          && request.resource.data.used == true
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['used', 'usedBy', 'usedAt']));
    }

    match /menus/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /beans/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notices/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stores/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      function isOwnAutoCouponId() {
        return couponId == 'welcome-' + request.auth.uid
          || couponId == 'birthday-' + string(request.time.year()) + '-'
            + request.auth.uid
          || couponId == 'birthday-' + string(request.time.year() - 1) + '-'
            + request.auth.uid;
      }

      allow read: if true;
      allow create: if isAdmin()
        || (isSignedIn()
          && isOwnAutoCouponId()
          && request.resource.data.isUsed == false
          && request.resource.data.discountAmount <= 3000
          && request.resource.data.discountRate <= 20);
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.isUsed != true
          && request.resource.data.isUsed == true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isUsed']));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
